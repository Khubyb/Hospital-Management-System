# Server Config
PORT=5000
NODE_ENV=development

# Database Config
MONGO_URI=mongodb://127.0.0.1:27017/hospital_management_system

# JWT Config
JWT_SECRET=supersecret_hms_jwt_key_12345
JWT_EXPIRES_IN=7d

# Email Config (Nodemailer Gmail SMTP)
# To use Gmail SMTP, set your Gmail address as EMAIL_USER and generate an App Password for EMAIL_PASS.
# If these are left blank, the app will run in "Mock Mode" and print emails directly to the console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Hospital Management System" <no-reply@hms.com>

# Frontend Config
FRONTEND_URL=http://localhost:5173
